# Extend serialization only. Never rewrite the pinned dependency working tree.
function(ac_prepare_reference_state beetle_root output_root)
    file(MAKE_DIRECTORY "${output_root}")
    file(READ "${beetle_root}/mednafen/pce/pce.cpp" machine)
    set(anchor "ret &= psg->StateAction(sm, load, data_only);")
    string(FIND "${machine}" "${anchor}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Pinned PCE serialization anchor missing")
    endif()
    string(REPLACE "${anchor}" "${anchor}\n\tHRBufs[0]->StateAction(sm, load, data_only, \"AC_OWL_L\", 0);\n\tHRBufs[1]->StateAction(sm, load, data_only, \"AC_OWL_R\", 0);" machine "${machine}")
    file(WRITE "${output_root}/pce.cpp" "${machine}")
    file(READ "${beetle_root}/mednafen/hw_sound/pce_psg/pce_psg.cpp" psg)
    set(anchor "SFVARN(pt->counter, \"counter\"),")
    string(FIND "${psg}" "${anchor}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Pinned PSG serialization anchor missing")
    endif()
    string(REPLACE "${anchor}" "${anchor}\n\t\t\tSFVARN(pt->lastts, \"AC_lastts\"),\n\t\t\tSFVARN(pt->freq_cache, \"AC_freq_cache\"),\n\t\t\tSFVARN(pt->samp_accum, \"AC_samp_accum\"),\n\t\t\tSFARRAY32N(pt->blip_prev_samp, 2, \"AC_blip_prev_samp\")," psg "${psg}")
    set(anchor "SFVAR(vol_pending),")
    string(FIND "${psg}" "${anchor}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Pinned PSG timestamp serialization anchor missing")
    endif()
    string(REPLACE "${anchor}" "${anchor}\n\t\tSFVAR(lastts)," psg "${psg}")
    file(WRITE "${output_root}/pce_psg.cpp" "${psg}")
    file(READ "${beetle_root}/mednafen/pce/huc6280.cpp" cpu)
    set(anchor "SFVAR(IODataBuffer),")
    string(FIND "${cpu}" "${anchor}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Pinned CPU serialization anchor missing")
    endif()
    string(REPLACE "${anchor}" "${anchor}\n\t\tSFVAR(timestamp),\n\t\tSFVAR(timestamp_frac),\n\t\tSFVAR(timer_lastts)," cpu "${cpu}")
    file(WRITE "${output_root}/huc6280.cpp" "${cpu}")
    file(READ "${beetle_root}/mednafen/pce/vce.cpp" vce)
    set(anchor "SFVAR(ws_counter),")
    string(FIND "${vce}" "${anchor}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Pinned VCE serialization anchor missing")
    endif()
    string(REPLACE "${anchor}" "${anchor}\n\t\tSFVAR(last_ts)," vce "${vce}")
    file(WRITE "${output_root}/vce.cpp" "${vce}")
endfunction()
