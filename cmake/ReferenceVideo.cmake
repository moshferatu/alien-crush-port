# Copy pinned sources; add optional observations at existing draw and palette boundaries.
function(ac_prepare_reference_video beetle_root vce_input output_root)
    file(MAKE_DIRECTORY "${output_root}")
    file(READ "${beetle_root}/mednafen/hw_video/huc6270/vdc.cpp" source)
    set(anchor "HPhaseCounter = (HDW_cache + 1) * 8 - Cycles_Between_RCRIRQ_And_HDWEnd;\n\t\t\t\tif(VPhase == VPHASE_VDW)\n\t\t\t\t{")
    string(FIND "${source}" "${anchor}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Pinned VDC display observation anchor missing")
    endif()
    string(REPLACE "${anchor}" "${anchor}\n\t\t\t\t\tif(ac_display_observer) ac_display_observer(RCRCount, CR_cache, burst_mode);" source "${source}")
    set(observer "// Read-only host observation; never serialized or consulted by emulation.\nusing AcDisplayObserver = void (*)(unsigned, unsigned, unsigned);\nstatic AcDisplayObserver ac_display_observer = nullptr;\nextern \"C\" void ac_set_display_observer(AcDisplayObserver callback) { ac_display_observer = callback; }\n")
    string(REPLACE "ac_display_observer(RCRCount, CR_cache, burst_mode)" "ac_display_observer(RCRCount, CR_cache, burst_mode, VRAM)" source "${source}")
    string(REPLACE "unsigned, unsigned, unsigned);" "unsigned, unsigned, unsigned, const unsigned short*);" observer "${observer}")
    file(WRITE "${output_root}/vdc.cpp" "${observer}${source}")
    file(READ "${vce_input}" vce)
    set(anchor "void VCE::Write(uint32 A, uint8 V)\n{\n\tSync(HuCPU.Timestamp());")
    string(FIND "${vce}" "${anchor}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Pinned VCE palette observation anchor missing")
    endif()
    set(hook "\n\tif(ac_palette_observer && ((A & 7) == 4 || (A & 7) == 5)) {\n\t\tunsigned index = ctaddress & 511;\n\t\tunsigned old_color = color_table[index];\n\t\tunsigned new_color = (A & 1) ? ((old_color & 255) | ((V & 1) << 8)) : ((old_color & 256) | V);\n\t\tint x = pixel_offset & 2047; if(x >= 1024) x -= 2048;\n\t\tac_palette_observer(scanline - (14 + scanline_start), x, index, old_color, new_color, FrameDone);\n\t}")
    # Record the framebuffer destination; the final crop is applied by the host.
    string(REPLACE "scanline - (14 + scanline_start), x" "(scanline_out_ptr && fb && pitch32) ? static_cast<int>((scanline_out_ptr - fb) / pitch32) : -1024, x" hook "${hook}")
    string(REPLACE "${anchor}" "${anchor}${hook}" vce "${vce}")
    set(anchor "DisplayRect->y = 14 + scanline_start;\n\tDisplayRect->h = scanline_end - scanline_start + 1;\n}")
    string(FIND "${vce}" "${anchor}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Pinned VCE final geometry observation anchor missing")
    endif()
    string(REPLACE "${anchor}" "DisplayRect->y = 14 + scanline_start;\n\tDisplayRect->h = scanline_end - scanline_start + 1;\n\tif(ac_palette_geometry) ac_palette_geometry(DisplayRect->x, DisplayRect->y);\n}" vce "${vce}")
    set(observer "// Read-only palette observation after Sync and before the existing write.\nusing AcPaletteObserver = void (*)(int, int, unsigned, unsigned, unsigned, unsigned);\nusing AcPaletteGeometry = void (*)(int, int);\nstatic AcPaletteObserver ac_palette_observer = nullptr;\nstatic AcPaletteGeometry ac_palette_geometry = nullptr;\nextern \"C\" void ac_set_palette_observer(AcPaletteObserver callback, AcPaletteGeometry geometry) { ac_palette_observer = callback; ac_palette_geometry = geometry; }\n")
    file(WRITE "${output_root}/vce.cpp" "${observer}${vce}")
endfunction()
